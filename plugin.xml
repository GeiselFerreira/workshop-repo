<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="cordova-plugin-carrier-name"
        version="1.0.1">

    <name>CarrierName</name>

    <description>
        Native Android Cordova plugin to retrieve the mobile network operator name.
    </description>

    <license>MIT</license>

    <js-module src="www/carriername.js" name="CarrierName">
        <clobbers target="cordova.plugins.carrierName" />
    </js-module>

    <platform name="android">

        <config-file target="config.xml" parent="/*">

            <feature name="CarrierName">
                <param
                    name="android-package"
                    value="com.carriername.plugin.CarrierName" />
            </feature>

        </config-file>

        <source-file
            src="src/android/CarrierName.java"
            target-dir="src/com/carriername/plugin" />

    </platform>

</plugin>
